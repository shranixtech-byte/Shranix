# SHRANIX Krushi ERP — Production Environment Template
# Copy to .env and configure for your environment

# ── Application ───────────────────────────────
NODE_ENV=production
APP_PORT=3001
APP_NAME=SHRANIX Krushi ERP

# ── Database ─────────────────────────────────
# PostgreSQL (Production)
DATABASE_URL=postgresql://user:password@localhost:5432/shranix_krushi_erp
DATABASE_PROVIDER=postgresql

# SQLite (Development)
# DATABASE_URL=sqlite://./data/shranix.db
# DATABASE_PROVIDER=sqlite

# ── Authentication ────────────────────────────
# Generate with: openssl rand -base64 64 (min 32 characters)
JWT_SECRET=change-this-to-a-random-64-character-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ── Redis (Cache & Queues) ────────────────────
REDIS_URL=redis://default:password@localhost:6379
REDIS_PASSWORD=your-redis-password

# ── Storage ───────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_PATH=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10

# ── Logging ──────────────────────────────────
APP_LOG_LEVEL=info

# ── Swagger ──────────────────────────────────
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ── AI Provider ──────────────────────────────
# Options: openai, gemini, claude, ollama
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@shranix.com
SMTP_PASS=
SMTP_FROM=SHRANIX ERP <notifications@shranix.com>

# ── Monitoring ───────────────────────────────
# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9464
