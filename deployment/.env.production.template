# ═══════════════════════════════════════════════════════════════════════
# SHRANIX Krushi ERP — Production Environment Template
# ═══════════════════════════════════════════════════════════════════════
# Copy to `.env.production` on the production host (or inject via secret
# manager / CI secrets). NEVER commit real values to version control.
# All REPLACE_ME values must come from a secure secret manager (17.4).
# ═══════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=SHRANIX-Krushi-ERP
APP_PORT=4001
APP_URL=https://api.shranix.in
# Production frontend origins only — never '*' for sensitive APIs (17.42/15).
CORS_ORIGINS=https://portal.shranix.in,https://app.shranix.in,tauri://localhost

# ── Database (production PostgreSQL, separate from staging) ─────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://shranix_prod:REPLACE_ME@prod-db-host:5432/shranix_erp?sslmode=require

# ── Auth / JWT (unique production secrets, 48+ bytes) ───────────────────
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_RANDOM_48_BYTES_BASE64
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_ME_RANDOM_48_BYTES_BASE64
JWT_REFRESH_EXPIRES_IN=30d

# ── License signing (Phase 13/15 — RSA private key PEM, KMS/HSM preferred) ──
#   openssl genrsa -out signing.key 4096  → store in KMS/HSM, never in git
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KEY_ID=key-1
LICENSE_SIGNING_ALGORITHM=rsa-sha256

# ── Payment (Phase 12) — live credentials ───────────────────────────────
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=REPLACE_ME
PAYMENT_KEY_ID=REPLACE_ME
PAYMENT_KEY_SECRET=REPLACE_ME

# ── Storage (DMS) — private bucket, short-lived signed URLs ─────────────
STORAGE_ADAPTER=minio
MINIO_ENDPOINT=minio-prod:9000
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
DMS_STORAGE_PATH=/app/storage/dms

# ── Email / Notifications ───────────────────────────────────────────────
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=SHRANIX ERP <noreply@shranix.com>

# ── Monitoring / observability ──────────────────────────────────────────
METRICS_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=json

# ── Rate limiting (shared across instances via proxy config) ────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ── Swagger (disabled in production) ────────────────────────────────────
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ── TLS / proxy (17.8/17.10 — HTTPS terminated at reverse proxy) ─────────
# TRUST_PROXY=true   # enable when behind nginx/load balancer
