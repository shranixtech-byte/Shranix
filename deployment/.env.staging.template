# ═══════════════════════════════════════════════════════════════════════
# SHRANIX Krushi ERP — Staging Environment Template
# ═══════════════════════════════════════════════════════════════════════
# Copy to `.env.staging` on the staging host. NEVER commit real values.
# Staging must NEVER point at production databases/secrets (Phase 17.2).
# ═══════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────
NODE_ENV=staging
APP_NAME=SHRANIX-Krushi-ERP-Staging
APP_PORT=4001
APP_URL=https://staging-api.shranix.in
# Staging frontend origin only — production origin NOT included.
CORS_ORIGINS=https://staging.shranix.in,tauri://localhost

# ── Database (separate staging DB!) ────────────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://staging_user:REPLACE_ME@staging-db-host:5432/shranix_erp_staging?sslmode=require

# ── Auth / JWT (generate unique staging secrets) ────────────────────────
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_RANDOM_48_BYTES_BASE64
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_ME_RANDOM_48_BYTES_BASE64
JWT_REFRESH_EXPIRES_IN=30d

# ── License signing (server-side RSA private key PEM; see Phase 13/15) ──
#   openssl genrsa -out signing.key 4096   (store in secret manager, never in git)
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KEY_ID=key-1
LICENSE_SIGNING_ALGORITHM=rsa-sha256

# ── Payment (Phase 12) — test-mode credentials for staging ──────────────
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=REPLACE_ME
PAYMENT_KEY_ID=REPLACE_ME
PAYMENT_KEY_SECRET=REPLACE_ME

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_ADAPTER=minio
MINIO_ENDPOINT=minio-staging:9000
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
DMS_STORAGE_PATH=/app/storage/dms

# ── Email / Notifications ───────────────────────────────────────────────
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=SHRANIX ERP Staging <noreply@shranix.com>

# ── Monitoring ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=json

# ── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ── Swagger (keep disabled on staging) ──────────────────────────────────
SWAGGER_ENABLED=false
