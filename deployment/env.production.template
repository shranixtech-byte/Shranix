# ═══════════════════════════════════════════════════════════════
# SHRANIX Krushi ERP — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this to Railway and fill in the values.
# NEVER commit this file with real values.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
APP_PORT=4001
APP_URL=https://api.shranix.com

# ── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=<GENERATE_64_CHAR_RANDOM_STRING>
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=604800

# ── CORS ─────────────────────────────────────────────────────
# Allowed origins for desktop app and web frontend
CORS_ORIGINS=https://app.shranix.com,https://shranix.com,tauri://localhost,https://*.tauri.localhost

# ── Redis (Optional — for rate limiting/sessions) ────────────
# REDIS_URL=rediss://default:password@host:6379

# ── File Storage ─────────────────────────────────────────────
STORAGE_ADAPTER=local
DMS_STORAGE_PATH=/app/storage/dms

# ── Email (Optional) ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@shranix.com

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=warn
DATABASE_LOG_LEVEL=error

# ── Security ─────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
SWAGGER_ENABLED=false
