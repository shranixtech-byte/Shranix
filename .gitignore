# =============================================================================
# SHRANIX Krushi ERP — .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
jspm_packages/

# --- Build Output ---
dist/
build/
out/
release/
*.tsbuildinfo

# --- Desktop Build Artifacts ---
desktop/build/
desktop/out/
desktop/release/
*.dmg
*.exe
*.msi
*.AppImage
*.snap
*.deb
*.rpm

# --- Environment & Secrets ---
# Only .env.example is committed — all real env files stay local
.env
.env.local
.env.development
.env.test
.env.staging
.env.production
.env.*.local
*.pem
*.key
*.cert
secrets/
credentials/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE & Editor ---
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# --- Testing ---
coverage/
.nyc_output/
*.test.ts.snap
test-results/
playwright-report/

# --- Database ---
# Local development databases & journals (NEVER commit)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/pgdata/
# Backup snapshots (VACUUM INTO copies) — never commit
**/backups/*.db
data/backups/
backend/data/backups/
database/data/
database/data/backups/
**/*.db.bak-restore-*

# --- Temp & Cache ---
.tmp/
.temp/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.next/
turbo/
.gatsby/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Test artifacts (invoice PDF/PNG renders, DB restore snapshots) ---
scripts/invoice-*.pdf
scripts/invoice-*.png
scripts/*.log
scripts/*.log.err
scripts/*.err
qa-browser-report.json
scripts/qa-browser-report.json

# --- Misc ---
*.bak
*.orig
*.tgz
*.zip
# Windows device names
backend/nul
database/nul
frontend/nul
# Windows NUL files
**/nul
nul
database/src/nul

# Neon CLI artifacts
.agents/
skills-lock.json

# Desktop (Tauri)
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/node_modules/
