# =============================================================================
# SHRANIX Krushi ERP — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=SHRANIX-Krushi-ERP
NODE_ENV=development
APP_PORT=4000
APP_VERSION=1.0.0

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shranix_krushi_erp
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# --- Authentication ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# --- Desktop ---
DESKTOP_WIDTH=1280
DESKTOP_HEIGHT=800
DESKTOP_MIN_WIDTH=1024
DESKTOP_MIN_HEIGHT=768
AUTO_UPDATE_ENABLED=false

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=./logs/app.log

# --- API ---
API_BASE_URL=http://localhost:4001/api/v1
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:4000

# --- File Storage ---
UPLOAD_DIR=./assets/uploads
MAX_FILE_SIZE=10485760

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@shranix.com

# --- Third-Party Services ---
# (Add keys as needed during integration)

# --- Feature Flags ---
FF_ENABLE_BIOMETRIC=false
FF_ENABLE_OFFLINE_MODE=true
FF_ENABLE_MULTI_TENANT=false
