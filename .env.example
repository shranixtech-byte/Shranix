# ═══════════════════════════════════════════════════════════════════════════
# SHRANIX Krushi ERP — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in real values for your environment.
# 3. NEVER commit `.env` or any real secrets to version control.
#
# For a quick local start (SQLite + dev defaults), only these are required:
#      DATABASE_URL, JWT_SECRET
#
# For production, generate strong values:
#      openssl rand -base64 48        # JWT_SECRET / JWT_REFRESH_SECRET
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development                       # development | test | production
APP_NAME=SHRANIX-Krushi-ERP
APP_PORT=4001                              # Backend API port
APP_URL=http://localhost:4001

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:4000,tauri://localhost

# Swagger (auto-generated API docs at /api/docs by default).
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ── Database ────────────────────────────────────────────────────────────────
# Provider: sqlite (dev default) or postgresql (production)
DATABASE_PROVIDER=sqlite
# SQLite (relative to the backend/database workspace root):
DATABASE_URL=file:./data/dev.db
# PostgreSQL (production):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/shranix_erp
# DATABASE_URL=postgresql://user:password@db-host:5432/shranix_erp?sslmode=require

# ── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED. Min 32 characters in production.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d                           # 1d | 7d | 15m | 60s ...
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                             # debug | info | warn | error
LOG_FORMAT=json                             # json | pretty | simple

# ── Cache / Queue (optional — Redis) ────────────────────────────────────────
# Used when Redis-backed caching/session stores are enabled.
REDIS_URL=redis://localhost:6379

# ── File Storage (DMS) ──────────────────────────────────────────────────────
# Storage adapter: local (default) | s3 | minio
STORAGE_ADAPTER=local
LOCAL_STORAGE_PATH=./storage/dms
# MinIO / S3-compatible object storage (production):
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=change_me
# MINIO_SECRET_KEY=change_me
# DMS_STORAGE_PATH=/app/storage/dms

# ── Email (SMTP) — used for notifications ───────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change_me
SMTP_FROM=SHRANIX ERP <noreply@example.com>
# Alternative: SendGrid API key (used when SMTP is not configured)
# SENDGRID_API_KEY=SG.change_me

# ── AI Assistant (optional) ─────────────────────────────────────────────────
# Provider: openai | claude | gemini | ollama
AI_PROVIDER=openai
AI_ENABLE_STREAMING=true
AI_ENABLE_INSIGHTS=true
AI_ENABLE_PREDICTIONS=true
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_RPM=60
AI_MAX_CONVERSATION_HISTORY=20
# Provider keys — only fill the one matching AI_PROVIDER:
# OPENAI_API_KEY=sk-change_me
# OPENAI_MODEL=gpt-4o
# CLAUDE_API_KEY=sk-ant-change_me
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=AIza-change_me
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# AI_FALLBACK_PROVIDER=ollama

# ── PDF Generation ──────────────────────────────────────────────────────────
# Path to Chrome/Chromium executable for server-side PDF rendering.
# Leave empty to auto-detect.
CHROME_PATH=

# ── Feature Flags ───────────────────────────────────────────────────────────
FF_ENABLE_BIOMETRIC=false
FF_ENABLE_OFFLINE_MODE=true

# ── Desktop App (Tauri) ─────────────────────────────────────────────────────
DESKTOP_WIDTH=1280
DESKTOP_HEIGHT=800
DESKTOP_MIN_WIDTH=1024
DESKTOP_MIN_HEIGHT=768
AUTO_UPDATE_ENABLED=false

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Used by the React app. Relative URL routes through the Vite dev proxy.
VITE_API_URL=/api/v1
