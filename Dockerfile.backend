# ═══════════════════════════════════════════════════════════════════
# STAGE 1: Dependencies
# ═══════════════════════════════════════════════════════════════════
FROM node:20-alpine AS deps
LABEL stage=deps

RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY database/package.json ./database/
COPY shared/package.json ./shared/
COPY scripts/package.json ./scripts/
COPY desktop/package.json ./desktop/

RUN npm install -g pnpm@9.15.0
RUN pnpm install --frozen-lockfile --prefer-offline

# ═══════════════════════════════════════════════════════════════════
# STAGE 2: Build
# ═══════════════════════════════════════════════════════════════════
FROM node:20-alpine AS builder
LABEL stage=builder

RUN apk add --no-cache python3 make g++
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY --from=deps /app/database/node_modules ./database/node_modules
COPY --from=deps /app/shared/node_modules ./shared/node_modules

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.json ./
COPY backend ./backend
COPY database ./database
COPY shared ./shared

RUN npm install -g pnpm@9.15.0
RUN pnpm turbo run build --filter=@shranix/database --filter=@shranix/shared --filter=@shranix/backend
RUN pnpm deploy --filter=@shranix/backend ./deploy

# ═══════════════════════════════════════════════════════════════════
# STAGE 3: Production
# ═══════════════════════════════════════════════════════════════════
FROM node:20-alpine AS runner
LABEL stage=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 appuser

WORKDIR /app

COPY --from=builder /app/deploy/dist ./dist
COPY --from=builder /app/deploy/package.json ./package.json
COPY --from=builder /app/deploy/node_modules ./node_modules

RUN mkdir -p /app/storage && chown -R appuser:nodejs /app/storage

USER appuser

ENV NODE_ENV=production
EXPOSE 4001

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4001/v1/health/live || exit 1

CMD ["node", "dist/main.js"]
