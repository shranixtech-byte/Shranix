{
  "productName": "SHRANIX Krushi ERP",
  "version": "1.0.0",
  "identifier": "com.shranix.krushi-erp",
  "build": {
    "beforeDevCommand": "pnpm --filter @shranix/frontend dev",
    "devUrl": "http://localhost:4000",
    "beforeBuildCommand": "pnpm --filter @shranix/frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SHRANIX Krushi ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": true,
      "tooltip": "SHRANIX Krushi ERP"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; script-src 'self' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*; img-src 'self' data: asset:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "resources": ["../runtime/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIHB1YmxpY2tleQ==",
      "endpoints": ["https://updates.shranix.com/api/updates/{{target}}/{{current_version}}"]
    }
  }
}
