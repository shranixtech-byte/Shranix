# ═══════════════════════════════════════════════════════════════════════════
# SHRANIX ERP — Staging Environment Template
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.staging and fill in staging-appropriate values.
# All values below are SAFE LOCAL DEVELOPMENT PLACEHOLDERS.
# NEVER commit real staging or production credentials.
#
# For quick local staging (uses docker-compose.staging.yml):
#   cp .env.staging.template .env.staging
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────
NODE_ENV=staging
APP_NAME=SHRANIX-Krushi-ERP-Staging
APP_PORT=4001
APP_URL=http://localhost:4001

# CORS — browser origins allowed to access the API
CORS_ORIGINS=http://localhost:80,http://localhost:4000

# Swagger docs (enabled in staging for operator convenience)
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://shranix:staging_dev_only_123@localhost:5432/shranix_erp

# ── Authentication (JWT) ────────────────────────────────────────────────
# Generate real values: openssl rand -base64 48
JWT_SECRET=staging-jwt-secret-minimum-32-characters!!
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=staging-refresh-secret-minimum-32-chars!!
JWT_REFRESH_EXPIRES_IN=30d

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Cache / Queue (Redis) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Storage (MinIO / S3-compatible) ───────────────────────────────
STORAGE_ADAPTER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=shranix_staging
MINIO_SECRET_KEY=staging_dev_only_123
DMS_STORAGE_PATH=./storage/dms

# ── Email (SMTP) — optional in staging ─────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging@example.com
SMTP_PASS=change_me
SMTP_FROM=SHRANIX ERP Staging <staging-noreply@example.com>

# ── Razorpay Sandbox ───────────────────────────────────────────────────
# Only fill if Razorpay sandbox testing is needed
# RAZORPAY_KEY_ID=rzp_test_change_me
# RAZORPAY_KEY_SECRET=change_me
# RAZORPAY_WEBHOOK_SECRET=change_me

# ── Monitoring (Sentry) ────────────────────────────────────────────────
# Only fill if Sentry is connected
# SENTRY_DSN=https://change_me@o0.ingest.sentry.io/0

# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_API_URL=/api/v1
