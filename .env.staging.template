# ═══════════════════════════════════════════════════════════════════════════
# SHRANIX Krushi ERP — Staging Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# H22 Staging Template — All values are PLACEHOLDERS.
# Replace with real staging values before deployment.
# NEVER commit real credentials to version control.
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=staging
APP_NAME=SHRANIX-Krushi-ERP
APP_PORT=4001
APP_URL=https://staging-api.shranix.example.com

# CORS — staging frontend origin
CORS_ORIGINS=https://staging.shranix.example.com,tauri://localhost

SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://shranix_staging:CHANGE_ME@staging-db-host:5432/shranix_erp_staging?sslmode=require

# ── Authentication (JWT) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Cache (Redis — optional) ────────────────────────────────────────────────
REDIS_URL=redis://staging-redis-host:6379

# ── File Storage (MinIO/S3) ────────────────────────────────────────────────
STORAGE_ADAPTER=minio
MINIO_ENDPOINT=staging-minio-host:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
DMS_STORAGE_PATH=/shranix-staging/dms

# ── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.staging.example.com
SMTP_PORT=587
SMTP_USER=notifications@staging.example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=SHRANIX ERP Staging <noreply@staging.example.com>

# ── Payment Sandbox ────────────────────────────────────────────────────────
# Razorpay test mode
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── TLS / Domain ───────────────────────────────────────────────────────────
# Managed by reverse proxy (nginx/caddy) — not application-level
# Ensure TLS termination happens before traffic reaches the backend

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── AI Assistant (optional) ────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o

# ── Feature Flags ───────────────────────────────────────────────────────────
FF_ENABLE_BIOMETRIC=false
FF_ENABLE_OFFLINE_MODE=false

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=https://staging-api.shranix.example.com/api/v1
